# frozen_string_literal: true
# sqa-cli — command-line interface for SQA analysis/backtesting/portfolio commands.

import_up "repo_dev.loki"

class Tasks
  @@gem_name ||= "sqa-cli".freeze

  header "sqa-cli v#{gem_version} — SQA command-line interface"

  desc "Run tests and RuboCop"
  def all
    sh "bundle exec rake all"
  end
end
